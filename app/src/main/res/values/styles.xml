<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card styles -->
    <style name="Widget.Dongmedicine.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_md</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <style name="Widget.Dongmedicine.Card.Organic" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/corner_radius_lg</item>
        <item name="cardElevation">@dimen/elevation_card</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>

    <!-- Text styles -->
    <style name="Widget.Dongmedicine.SectionTitle" parent="">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/on_surface</item>
    </style>

    <style name="Widget.Dongmedicine.BodyText" parent="">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <style name="Widget.Dongmedicine.Caption" parent="">
        <item name="android:textSize">@dimen/text_size_caption</item>
        <item name="android:textColor">@color/on_surface_variant</item>
    </style>

    <!-- Chip style -->
    <style name="Widget.Dongmedicine.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/corner_radius_lg</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipBackgroundColor">@color/chip_unselected_bg</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Dongmedicine.Chip.Selected" parent="Widget.Dongmedicine.Chip">
        <item name="chipBackgroundColor">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <!-- Empty state -->
    <style name="Widget.Dongmedicine.EmptyState" parent="Widget.Dongmedicine.Caption">
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- ShapeAppearance for rounded images -->
    <style name="ShapeAppearance.DongMed.CornerMd" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_md</item>
    </style>

    <style name="ShapeAppearance.DongMed.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_radius_circle</item>
    </style>
</resources>
